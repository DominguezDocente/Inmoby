{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {

    "Routes": {

      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },

      "propertiesRoute": {
        "ClusterId": "propertiesCluster",
        "Match": {
          "Path": "properties/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/properties"
          }
        ]
      }

    },

    "Clusters": {

      "identityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://127.0.0.1:7001/api/"
          }
        }
      },

      "propertiesCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://127.0.0.1:7000/api/"
          }
        }
      }

    }
  }
}
