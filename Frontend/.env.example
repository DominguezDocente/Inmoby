# URL base para las peticiones al API Gateway.
# En desarrollo se deja vacío para usar el proxy de Vite (evita problemas de CORS).
# En producción se puede apuntar directamente al gateway, por ejemplo:
# VITE_API_BASE_URL=https://gateway.inmoby.local
VITE_API_BASE_URL=

# Destino del proxy de Vite en desarrollo.
VITE_GATEWAY_URL=https://localhost:7777
